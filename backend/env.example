# Copiar a .env y completar los valores:  cp env.example .env

# Puerto local del servidor
PORT=3000

# Cadena de conexion PostgreSQL (Neon / Supabase)
DATABASE_URL=postgresql://usuario:password@host/basededatos

# Poner en 'false' solo para una base local sin SSL
DATABASE_SSL=true

# Secreto para firmar los JWT (fase 1)
JWT_SECRET=cambiar-en-produccion
