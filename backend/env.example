# Copiar a .env y completar los valores:  cp env.example .env

# Puerto local del servidor
PORT=3000

# Cadena de conexion PostgreSQL (Neon / Supabase)
DATABASE_URL=postgresql://usuario:password@host/basededatos

# Poner en 'false' solo para una base local sin SSL
DATABASE_SSL=true

# Secreto para firmar los JWT (fase 1)
JWT_SECRET=cambiar-en-produccion

# Envio de boletos por correo (fase 5). Sin BREVO_API_KEY ni SMTP_HOST,
# POST /ventas/:id/enviar responde 502 en vez de fallar oscuro.
# Opcion recomendada: API HTTPS de Brevo (funciona en Render gratis, que bloquea SMTP).
# MAIL_FROM debe ser un remitente verificado en Brevo ("Nombre <correo@dominio>").
BREVO_API_KEY=
MAIL_FROM=SVB-GUA <no-reply@svb-gua.local>
# Datos del emisor que salen en la factura PDF adjunta al correo (opcionales; sin ellas: "SVB-GUA", sin NIT).
FACTURA_EMISOR=
FACTURA_NIT=
FACTURA_DIRECCION=
# Alternativa local/otro proveedor: SMTP (se usa solo si no hay BREVO_API_KEY).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=SVB-GUA <no-reply@svb-gua.local>
